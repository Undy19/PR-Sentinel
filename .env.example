TELEGRAM_BOT_TOKEN=your-telegram-bot-token
GITHUB_TOKEN=your-github-token
# Required: dedicated HMAC key for X-Hub-Signature-256 (SEC-02). Use a
# separate random value (not GITHUB_TOKEN) and set it as the "Secret" in your
# GitHub webhook configuration (Settings → Webhooks → Secret).
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
DATABASE_PATH=pr_sentinel.db
GITHUB_REPO=owner/repo
TELEGRAM_CHAT_ID=123456789
NOTIFICATION_LANGUAGE=ru
# Optional: X-GitHub-Delivery dedup / replay protection (SEC-09). Default true.
# Set REPLAY_PROTECTION_ENABLED=false to temporarily disable duplicate skipping.
REPLAY_PROTECTION_ENABLED=true
